function datashopcat2():

    delete {SHOP_data.cat.2::*}

    set {SHOP_data.cat.name.2} to "Bois et Bûches"
    set {SHOP_data.cat.item.2} to oak wood

    # Shop – Bois (Bûches)

    # Oak Log / Chêne
    set {_nom} to "Bûche de chêne"
    set {_item} to oak_log
    set {_prix} to 3
    set {_variation} to 20
    set {_fluctuation} to 0.18
    add {_item} to {SHOP_data.cat.2::*}
    set {SHOP_data.nom.%{_item}%} to {_nom}
    set {SHOP_data.prix.%{_item}%} to {_prix}
    set {SHOP_data.variation.%{_item}%} to {_variation}
    set {SHOP_data.fluctuation.%{_item}%} to {_fluctuation}

    # Spruce Log / Sapin
    set {_nom} to "Bûche de sapin"
    set {_item} to spruce_log
    set {_prix} to 3
    set {_variation} to 20
    set {_fluctuation} to 0.18
    add {_item} to {SHOP_data.cat.2::*}
    set {SHOP_data.nom.%{_item}%} to {_nom}
    set {SHOP_data.prix.%{_item}%} to {_prix}
    set {SHOP_data.variation.%{_item}%} to {_variation}
    set {SHOP_data.fluctuation.%{_item}%} to {_fluctuation}

