function datashopcat4():

    delete {SHOP_data.cat.4::*}

    set {SHOP_data.cat.name.4} to "Minerais et Métaux"
    set {SHOP_data.cat.item.4} to iron ingot

    # Shop – Minerais

    # Coal / Charbon
    set {_nom} to "Charbon"
    set {_item} to coal
    set {_prix} to 5
    set {_variation} to 20
    set {_fluctuation} to 0.3
    add {_item} to {SHOP_data.cat.4::*}
    set {SHOP_data.nom.%{_item}%} to {_nom}
    set {SHOP_data.prix.%{_item}%} to {_prix}
    set {SHOP_data.variation.%{_item}%} to {_variation}
    set {SHOP_data.fluctuation.%{_item}%} to {_fluctuation}

