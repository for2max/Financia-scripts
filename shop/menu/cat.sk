

function Shop_CAT(p: player,action: text,cat: number,select: number):
    set {_name} to {SHOP_data.cat.name.%{_cat}%}
    set {_size} to size of {SHOP_data.cat.%{_cat}%::*}
    set {_Z} to floor(({_size} - 1) / 7) + 1

    set {_f} to first character of {_action}
    create a new gui with virtual chest inventory named "%{_f}%: %{_name}%" with ({_z}+2) rows:
        open last created gui to {_p}
        Menu({_p})

        loop (({_z}+2)*9) times:
            make gui slot ((loop-number)-1) with gray stained glass pane

        make gui slot ((({_z}+2)*9)-1) with oak door named "&cRetour":
            Main_Menu_Cats({_p},{_action})

        set {_protect} to ({Grade_%{_p}%}/2)
        make gui slot (((({_z}+2)*9)-1)-1) with clock named "&eInformations" with lore "&7&oUn marché boursier régule cette boutique.", "&7&oLa valeur des articles s'actualise.", "", "&7&eProchaine mise à jour boursière :", "&7&o%{SHOP_BOURSE_LAST.DIFF}%", "", "&7&eProtection boursière :", "&a+%{_protect}%%% &7&o(Grade de niveau %{Grade_%{_p}%}%)":
            Shop_CAT({_p},{_action},{_cat},{_select})
        make gui slot (((({_z}+2)*9)-1)-2) with {_select} of sunflower named "&eQuantité &bx%{_select}%" with lore "&7&oLa quantité d’objets que vous avez choisie.", "&7&oCliquez ici pour modifier.":
            Shop_SELECT(p: player,{_action},{_cat},{_select})
            Menu({_p})

        set {_s} to 10
        set {_nb} to 0
        loop {SHOP_data.cat.%{_cat}%::*}:
            add 1 to {_nb}

            set {_item } to loop-value
            set {_name} to "%{SHOP_data.nom.%{_item}%}%"
            set {_variation} to {SHOP_BOURSE.VARIATION.%{_item}%}
            set {_variation.affiche} to {_variation}

            if {_action} is "Acheter":
                set {_prixA} to ({SHOP_data.prix.%{_item}%} * (1 + (70 / 100)))*{_select}
                set {_prixB} to ({SHOP_BOURSE.PRIX.%{_item}%} * (1 + (70 / 100)))*{_select}
                set {_lore1} to "&7&oClique ici pour acheter."
                set {_lore2} to ""
                
                if {_variation.affiche} > 0:
                    set {_variation.affiche} to "&c+%{_variation.affiche}%%%"
                else:
                    set {_variation.affiche} to "&a%{_variation.affiche}%%%"
                    set {_item} to {_item} with enchantment glint

            if {_action} is "Vendre":

                set {_prixA} to {SHOP_data.prix.%{_item}%}*{_select}
                set {_prixB} to {SHOP_BOURSE.PRIX.%{_item}%}*{_select}
                set {_lore1} to "&7&oClique ici pour vendre."
                set {_lore2} to "&bClique molette pour tout vendre."

                #PROTECTION BOURISERE
                if {_variation.affiche} < 0:
                    set {_prixBB} to {_prixB}
                    set {_prixB} to ({SHOP_BOURSE.PRIX.%{_item}%} * (1 + ({_protect} / 100)))*{_select}
                    set {_diff} to difference between {_prixBB} and {_prixB}
                    add {_protect} to {_variation.affiche}
                #FIN DE PROTECTION AVANTAGE


                if {_variation.affiche} > 0:
                    set {_variation.affiche} to "&a+%{_variation.affiche}%%%"
                    set {_item} to {_item} with enchantment glint
                else:
                    set {_variation.affiche} to "&c%{_variation.affiche}%%%"
                

            set {_objet} to loop-value
            make gui slot {_s} with {_select} of {_item} named "&e%{_name}% %{_variation.affiche}%" with lore "", "&c$%{_prixA}%&r &7→ &a$%{_prixB}% &7&o(x%{_select}%)", "%{_lore1}%", "%{_lore2}%":

                set {_type} to click type
                if {_action} is "Vendre":
                    if "%{_type}%" contain "middle":
                        if {PREMIUM_%{_p}%} is not set:
                            set {_nb} to amount of {_objet} in player's inventory
                            set {_selectbase} to {_nb}
                            set {_select} to {_nb}
                            set {_prixB} to {SHOP_BOURSE.PRIX.%{_objet}%}*{_select}
                    if {_p} has {_select} of {_objet}:
                        remove {_select} of {_objet} from {_p}'s inventory
                        add {_prixB} to {_p}'s balance
                        send "" to {_p}
                        send "&aVous avez vendu &e%{_select}% %{_name}%&a à la boutique pour &e$%{_prixB}%&a." to {_p}
                        send "&6Protection boursière de votre grade : &e+$%{_protect}%%%&6."
                        send "&aSolde : &c%{_p}'s balance%" to {_p}
                        send "" to {_p}
                        OK({_p})

                        # STATISTIQUES
                        add {_select} to {STATS_%{_p}%.shop.nb.%{_cat}%}
                        add {_prixB} to {STATS_%{_p}%.shop.money.%{_cat}%}

                        #SOCIETE REPUTATION
                        set {_reputation} to {_prixB}*3
                        # ADD + MESSAGE REPUTATION SOCIETE
                        #set {_select} to {_selectbase}
                    else:
                        NO({_p})
                        make gui slot {_s} with barrier named "&c&nErreur" with lore "&eVous n'avez pas x%{_select}% %{_name}%.":
                            Shop_CAT({_p},{_action},{_cat},{_select})
                                
                
                if {_action} is "Acheter":

                    if {_prixB} > {_p}'s balance:
                        NO({_p})
                        make gui slot {_s} with barrier named "&c&nErreur" with lore "&eVous n'avez pas assez d'argent.":
                            Shop_CAT({_p},{_action},{_cat},{_select})
                    else:
                        remove {_prixB} from {_p}'s balance
                        OK({_p})
                        give {_select} of {_objet} to {_p}
                        send "" to {_p}
                        send "&aVous avez reçu &e%{_select}% %{_name}%&a pour un total de &e$%{_prixB}%&a." to {_p}
                        send "&aSolde: &c%{_p}'s balance%" to {_p}
                        send "" to {_p}


            if {_nb} > 6:
                add 3 to {_s}
                set {_nb} to 0
            else:
                add 1 to {_s}





