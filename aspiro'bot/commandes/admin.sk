function Aspirobot_teleport(p: player,id: integer):
	set {_can-teleport} to false
	if {_p} has permission "premium.aspirobot":
		set {_can-teleport} to true
	if {_p} has permission "admin.aspirobot":
		set {_can-teleport} to true
	if {_can-teleport} is false:
		send "&7[&6Aspiro'&9BOT&7] &cLa téléportation vers vos robots est réservée au grade premium." to {_p}
		stop

	if {Aspirobot_%{_id}%::owner} is not {_p}:
		send "&7[&6Aspiro'&9BOT&7] &cCet Aspiro'BOT ne vous appartient pas." to {_p}
		stop

	set {_destination} to {Aspirobot_%{_id}%::location}
	if {_destination} is not set:
		send "&7[&6Aspiro'&9BOT&7] &cL'emplacement de cet Aspiro'BOT est introuvable." to {_p}
		stop

	add 0.5 to x-coordinate of {_destination}
	add 1 to y-coordinate of {_destination}
	add 0.5 to z-coordinate of {_destination}
	teleport {_p} to {_destination}
	send "&7[&6Aspiro'&9BOT&7] &aVous avez été téléporté à votre Aspiro'BOT &e%{_id}%&a." to {_p}

function Aspirobot_liste(p: player,page: integer):
	set {_robots::*} to {Aspirobot_%{_p}%::*}
	set {_size} to size of {_robots::*}
	if {_size} <= 0:
		send "&7[&6Aspiro'&9BOT&7] &eVous n'avez aucun Aspiro'BOT posé." to {_p}
		stop

	set {_nbpage} to floor(({_size} - 1) / 36) + 1
	create a new gui with virtual chest inventory named "Vos Aspiro'BOT - %{_page}%/%{_nbpage}%" with 6 rows:
		open last created gui to {_p}
		Menu({_p})

		loop 9 times:
			make gui slot ((loop-number) - 1) with gray stained glass pane
		loop 36 times:
			make gui slot ((loop-number) + 8) with light blue stained glass pane
		loop 9 times:
			make gui slot ((loop-number) + 44) with gray stained glass pane

		set {_start} to (({_page} - 1) * 36) + 1
		set {_end} to {_start} + 35
		set {_index} to 0
		set {_slot} to 9
		loop {_robots::*}:
			set {_id} to loop-value
			if {Aspirobot_%{_id}%::owner} is {_p}:
				add 1 to {_index}
				if {_index} >= {_start}:
					if {_index} <= {_end}:
						set {_niveau} to {Aspirobot_%{_id}%::niveau}
						if {_niveau} is not set:
							set {_niveau} to 0
						set {_redstone} to {Aspirobot_%{_id}%::energie}
						if {_redstone} is not set:
							set {_redstone} to 0
						set {_bar} to {Aspirobot_%{_id}%::bar}
						if {_bar} is not set:
							set {_bar} to 0
						set {_utilisations-par-redstone} to 7 + (3 * {_niveau})
						set {_utilisations-restantes} to ({_redstone} * {_utilisations-par-redstone}) + {_bar}
						set {_utilisations-max} to 64 * {_niveau} * {_utilisations-par-redstone}
						if {_utilisations-max} > 0:
							set {_batterie} to floor(({_utilisations-restantes} / {_utilisations-max}) * 100)
						else:
							set {_batterie} to 0
						if {_batterie} > 100:
							set {_batterie} to 100
						if {_batterie} < 0:
							set {_batterie} to 0
						set {_location} to {Aspirobot_%{_id}%::location}
						if {_location} is set:
							set {_x} to x-coordinate of {_location}
							set {_y} to y-coordinate of {_location}
							set {_z} to z-coordinate of {_location}
							set {_location-text} to "x: %{_x}%, y: %{_y}%, z: %{_z}%"
						else:
							set {_location-text} to "Inconnue"
						set {_item-lore::*} to "&7Emplacement : &f%{_location-text}%", "&7Niveau : &e%{_niveau}%", "&7Batterie restante : &a%{_batterie}%%%", "&7Énergie : &f%{_redstone}% redstone &7| &f%{_bar}% utilisations chargées"
						set {_can-teleport} to false
						if {_p} has permission "premium.aspirobot":
							set {_can-teleport} to true
						if {_p} has permission "admin.aspirobot":
							set {_can-teleport} to true
						if {_can-teleport} is true:
							add "&aCliquez pour vous téléporter au hopper." to {_item-lore::*}
						else:
							add "&cTéléportation réservée au grade premium." to {_item-lore::*}
						set {_item} to hopper named "&6Aspiro'&9BOT &7(ID: &e%{_id}%&7)" with lore {_item-lore::*}
						make gui slot {_slot} with {_item}:
							Aspirobot_teleport({_p},{_id})
						add 1 to {_slot}

		set {_info} to book named "&eVos Aspiro'BOT" with lore "&7Robots enregistrés : &f%{_index}%" and "&7Page &e%{_page}%&7/&e%{_nbpage}%"
		make gui slot 49 with {_info}
		make gui slot 48 with arrow named "&ePage précédente":
			if {_page} > 1:
				set {_previous-page} to {_page} - 1
				Aspirobot_liste({_p},{_previous-page})
		make gui slot 50 with arrow named "&ePage suivante":
			if {_page} < {_nbpage}:
				set {_next-page} to {_page} + 1
				Aspirobot_liste({_p},{_next-page})

command /mesaspirobots:
	aliases: aspirobots
	trigger:
		Aspirobot_liste(player,1)

command /adminaspirobot [<text>] [<text>] [<integer>]:
	permission: admin.aspirobot
	trigger:
		if arg 1 is "help":
			send "&7&m--------------------------------" to player
			send "&6Aide - /adminaspirobot" to player
			send "&e/adminaspirobot help &7- Affiche cette aide." to player
			send "&e/adminaspirobot info [ID] &7- Affiche les informations d'un Aspiro'BOT." to player
			send "&e/adminaspirobot give <joueur> <niveau> &7- Donne un Aspiro'BOT du niveau choisi." to player
			send "&e/adminaspirobot supprimer <ID> &7- Supprime les données du bot et sa trémie, si elle est présente." to player
			send "&e/adminaspirobot supprimer tout &7- Supprime tous les Aspiro'BOT enregistrés et leurs trémies." to player
			send "&7&m--------------------------------" to player
			stop

		if arg 1 is "info":
			if arg 2 is set:
				set {_id} to arg 2 parsed as integer
				if {_id} is not set:
					send "&7[&6Aspiro'&9BOT&7] &cL'ID doit être un nombre entier." to player
					stop
			else:
				set {_loc} to location of target block
				if {_loc} is not set:
					send "&7[&6Aspiro'&9BOT&7] &cVous devez viser l'Aspiro'BOT ou préciser son ID." to player
					stop
				set {_id} to {Aspirobot_reverse::%{_loc}%}

			if {_id} is not set:
				send "&7[&6Aspiro'&9BOT&7] &cAucun Aspiro'BOT n'a été trouvé à cet emplacement." to player
				stop
			if {Aspirobot_%{_id}%::owner} is not set:
				send "&7[&6Aspiro'&9BOT&7] &cAucun Aspiro'BOT enregistré avec l'ID &e%{_id}%&c." to player
				stop

			set {_owner} to {Aspirobot_%{_id}%::owner}
			send "&7&m--------------------------------" to player
			send "&6Informations de l'Aspiro'BOT &7(ID: &e%{_id}%&7)" to player
			send "&7Propriétaire : &f%{_owner}%" to player
			send "&7Niveau : &f%{Aspirobot_%{_id}%::niveau}%" to player
			send "&7Emplacement : &f%{Aspirobot_%{_id}%::location}%" to player
			send "&7Redstone en réserve : &f%{Aspirobot_%{_id}%::energie}%" to player
			send "&7Utilisations restantes sur la redstone en cours : &f%{Aspirobot_%{_id}%::bar}%" to player
			send "&7Secondes avant aspiration : &f%{Aspirobot_%{_id}%::secondes}%" to player

			if {Aspirobot_%{_owner}%::*} contains {_id}:
				send "&7Index du propriétaire : &aOK" to player
			else:
				send "&7Index du propriétaire : &cAbsent" to player

			if {Aspirobot_list::*} contains {_id}:
				send "&7Index global : &aOK" to player
			else:
				send "&7Index global : &cAbsent" to player
			send "&7&m--------------------------------" to player
			stop

		if arg 1 is "give":
			if arg 2 or arg 3 is not set:
				send "&7[&6Aspiro'&9BOT&7] &eUtilisation : /adminaspirobot give <joueur> <niveau>" to player
				stop

			set {_target} to arg 2 parsed as player
			if {_target} is not set:
				send "&7[&6Aspiro'&9BOT&7] &cJoueur introuvable ou non connecté." to player
				stop

			set {_niveau} to arg 3
			if {_niveau} < 1:
				send "&7[&6Aspiro'&9BOT&7] &cLe niveau doit être compris entre 1 et 7." to player
				stop
			if {_niveau} > 7:
				send "&7[&6Aspiro'&9BOT&7] &cLe niveau doit être compris entre 1 et 7." to player
				stop
			set {_success} to Aspirobot_give({_target}, {_niveau})
			if {_success} is true:
				Aspirobot_log("COMMANDE ADMIN GIVE | admin=%name of player% | joueur=%name of {_target}% | niveau=%{_niveau}%")
				send "&7[&6Aspiro'&9BOT&7] &aUn Aspiro'BOT de niveau &e%{_niveau}% &aa été donné à &e%{_target}%&a." to player
			stop

		if arg 1 is "supprimer":
			if arg 2 is not set:
				send "&7[&6Aspiro'&9BOT&7] &eUtilisation : /adminaspirobot supprimer <ID|tout>" to player
				stop

			if arg 2 is "tout":
				set {_ids::*} to {Aspirobot_list::*}
				set {_robots-supprimes} to 0
				set {_tremies-supprimees} to 0

				loop {_ids::*}:
					set {_id} to loop-value
					if {Aspirobot_%{_id}%::owner} is set:
						set {_owner} to {Aspirobot_%{_id}%::owner}
						set {_block-removed} to Aspirobot_delete({_id})
						if {_block-removed} is true:
							add 1 to {_tremies-supprimees}
						Aspirobot_log("COMMANDE ADMIN SUPPRESSION TOTALE | admin=%name of player% | id=%{_id}% | proprietaire=%{_owner}%")
						add 1 to {_robots-supprimes}

				delete {Aspirobot_reverse::*}
				delete {Aspirobot_list::*}
				Aspirobot_log("COMMANDE ADMIN SUPPRESSION TOTALE TERMINEE | admin=%name of player% | robots=%{_robots-supprimes}% | tremies=%{_tremies-supprimees}%")
				send "&7[&6Aspiro'&9BOT&7] &a%{_robots-supprimes}% Aspiro'BOT supprimé(s), dont &e%{_tremies-supprimees}% trémie(s)&a. Toutes les données associées ont été effacées." to player
				stop

			set {_id} to arg 2 parsed as integer
			if {_id} is not set:
				send "&7[&6Aspiro'&9BOT&7] &cL'ID doit être un nombre entier." to player
				stop
			if {Aspirobot_%{_id}%::owner} is not set:
				send "&7[&6Aspiro'&9BOT&7] &cAucun Aspiro'BOT enregistré avec l'ID &e%{_id}%&c." to player
				stop

			set {_owner} to {Aspirobot_%{_id}%::owner}
			set {_block-removed} to Aspirobot_delete({_id})
			Aspirobot_log("COMMANDE ADMIN SUPPRESSION | admin=%name of player% | id=%{_id}% | proprietaire=%{_owner}% | tremie_supprimee=%{_block-removed}%")
			if {_block-removed} is true:
				send "&7[&6Aspiro'&9BOT&7] &aL'Aspiro'BOT &e%{_id}%&a, ses données et sa trémie ont été supprimés." to player
			else:
				send "&7[&6Aspiro'&9BOT&7] &aLes données de l'Aspiro'BOT &e%{_id}%&a ont été supprimées. Aucune trémie n'a été trouvée à son emplacement enregistré." to player
			stop

		send "&7[&6Aspiro'&9BOT&7] &eUtilisation : /adminaspirobot help" to player
