function Agritech_upgrade_price(niveau: integer) :: number:
	if {_niveau} = 1:
		return 0
	else if {_niveau} = 2:
		return 100
	else if {_niveau} = 3:
		return 250
	else if {_niveau} = 4:
		return 500
	else if {_niveau} = 5:
		return 1000
	else if {_niveau} = 6:
		return 2000
	else if {_niveau} = 7:
		return 4000
	return -1

function Agritech_upgrade_buy(p: player,id: integer):
	if {agritech_%{_id}%::owner} is not {_p}:
		if {_p} does not have permission "agritech.admin":
			send "&7[&c&nErreur&7] &eVous n'avez pas accès à cet automate agricole." to {_p}
			stop

	set {_niveau-actuel} to {agritech_%{_id}%::niveau}
	if {_niveau-actuel} is not set:
		send "&8[&cAgri'Tech&8] &cCet automate est introuvable ou n'est plus actif." to {_p}
		stop
	if {_niveau-actuel} >= 7:
		send "&7[&6Agri'&9Tech&7] &eCet automate est déjà au niveau maximum." to {_p}
		stop

	set {_niveau-suivant} to {_niveau-actuel} + 1
	set {_prix} to Agritech_upgrade_price({_niveau-suivant})
	if {_prix} < 0:
		send "&7[&c&nErreur&7] &eLe prix de ce niveau n'est pas configuré." to {_p}
		stop

	if {_p}'s balance < {_prix}:
		send "&7[&c&nErreur&7] &eIl vous faut &6$%{_prix}%&e pour acheter le niveau %{_niveau-suivant}%." to {_p}
		play sound "entity.villager.no" with volume 1 to {_p}
		stop

	remove {_prix} from {_p}'s balance
	set {_ancienne-gauche} to {agritech_%{_id}%::coin-1}
	set {_ancienne-droite} to {agritech_%{_id}%::coin-2}
	if {_ancienne-gauche} is set:
		if block at {_ancienne-gauche} is emerald block:
			set block at {_ancienne-gauche} to air
	if {_ancienne-droite} is set:
		if block at {_ancienne-droite} is redstone block:
			set block at {_ancienne-droite} to air

	set {agritech_%{_id}%::niveau} to {_niveau-suivant}
	set {_location} to {agritech_%{_id}%::location}
	agritech_set_zone({_id}, {_location})
	agritech_display({_id})
	send "&7[&6Agri'&9Tech&7] &aAmélioration achetée ! Votre automate est maintenant niveau &e%{_niveau-suivant}%&a pour &6$%{_prix}%&a." to {_p}
	play sound "entity.experience_orb.pickup" with volume 1 to {_p}
	Agritech_upgrade({_p}, {_id})

function Agritech_upgrade(p: player,id: integer):
	if {agritech_%{_id}%::owner} is not {_p}:
		if {_p} does not have permission "agritech.admin":
			send "&7[&c&nErreur&7] &eVous n'avez pas accès à cet automate agricole." to {_p}
			stop

	set {_niveau-actuel} to {agritech_%{_id}%::niveau}
	if {_niveau-actuel} is not set:
		send "&8[&cAgri'Tech&8] &cCet automate est introuvable ou n'est plus actif." to {_p}
		stop

	create a new gui with virtual chest inventory named "Agri'TECH - ID %{_id}%" with 3 rows:
		open last created gui to {_p}
		Menu({_p})

		loop 27 times:
			make gui slot ((loop-number) - 1) with gray stained glass pane

		loop 7 times:
			set {_niveau-selectionne} to loop-number
			set {_slot} to 9 + loop-number
			set {_couverture} to {_niveau-selectionne} + 4
			set {_stockage-max} to 256 * {_niveau-selectionne}
			set {_redstone-max} to 64 * {_niveau-selectionne}
			set {_cycles-par-redstone} to 7 + (3 * {_niveau-selectionne})
			set {_delai} to 12 - {_niveau-selectionne}

			if {_niveau-selectionne} <= {_niveau-actuel}:
				set {_item} to beacon named "&aNiveau %{_niveau-selectionne}% &8(Débloqué)" with lore "&7Couverture : &b%{_couverture}% x %{_couverture}% blocs", "&7Stockage maximal : &e%{_stockage-max}% objets", "&7Stock maximal : &c%{_redstone-max}% redstone", "&7Cycles par redstone : &a%{_cycles-par-redstone}%", "&7Délai de récolte : &e%{_delai}% minute(s)" and "&7Ce niveau est déjà débloqué."
				force {_item} to glint
				make gui slot {_slot} with {_item}
			else if {_niveau-selectionne} = {_niveau-actuel} + 1:
				set {_prix} to Agritech_upgrade_price({_niveau-selectionne})
				set {_item} to beacon named "&eAméliorer au niveau %{_niveau-selectionne}%" with lore "&7Couverture : &b%{_couverture}% x %{_couverture}% blocs", "&7Stockage maximal : &e%{_stockage-max}% objets", "&7Stock maximal : &c%{_redstone-max}% redstone", "&7Cycles par redstone : &a%{_cycles-par-redstone}%", "&7Délai de récolte : &e%{_delai}% minute(s)", "&7Prix : &6$%{_prix}%" and "&aCliquez pour acheter cette amélioration."
				make gui slot {_slot} with {_item}:
					Agritech_upgrade_buy({_p}, {_id})
			else:
				set {_item} to barrier named "&cNiveau %{_niveau-selectionne}% &8(Verrouillé)" with lore "&7Couverture : &b%{_couverture}% x %{_couverture}% blocs", "&7Stockage maximal : &e%{_stockage-max}% objets", "&7Stock maximal : &c%{_redstone-max}% redstone", "&7Cycles par redstone : &a%{_cycles-par-redstone}%", "&7Délai de récolte : &e%{_delai}% minute(s)" and "&7Débloquez d'abord le niveau précédent."
				make gui slot {_slot} with {_item}

		make gui slot 22 with oak door named "&cRetour":
			Agritech_Menu({_p}, {_id})
