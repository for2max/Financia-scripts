
every 1 second:

    loop {agritech_total::*}:
        set {_id} to loop-value
        agritech_main_prod({_id})
        agritech_display({_id})

function agritech_main_prod(id: number):

    set {_return} to agritech_verif_energie({_id},false)
    if {_return} is false:
        stop
    if {agritech_%{_id}%::owner} is not online:
        stop

    set {_return} to agritech_check_time({_id})
    if {_return} is false:
        stop

    loop all blocks within {agritech_%{_id}%::coin-1} and {agritech_%{_id}%::coin-2}:
        set {_type} to type of block at loop-block
        if "%{_type}%" contain "sweet berry bush":
            set {_type} to sweet berry bush
        if "%{_type}%" contain "cactus":
            set {_type} to cactus

        if {agritech_data-age::*} contain {_type}:
            agritech_prod_age({_id},location of loop-block)
        else if {agritech_data-type::*} contain {_type}:
            agritech_prod_type({_id},location of loop-block)
        else if {agritech_data-hauteur::*} contain {_type}:
            agritech_prod_hauteur({_id},location of loop-block)



function agritech_prod_age(id: number,loc: location):

    set {_plante} to type of block at {_loc}
    if "%{_plante}%" is "sweet berry bush":
        set {_plante} to sweet berry bush

    if {agritech_data-age::*} contain {_plante}:
        set {_return} to agritech_verif_energie({_id},false)
        if {_return} is true:

            set {_text} to "%{_plante}%"
            set {_return} to agritech_verif_stockage({_id},{agritech_data-nb-%{_text}%})
            #broadcast "%{_return}%"
            if {_return} is true:

                if age of block at {_loc} is maximum age of block at {_loc}:
                    agritech_verif_energie({_id},true)
                    if {_plante} is sweet berry bush:
                        set age of block at {_loc} to 1
                    else:
                        set age of block at {_loc} to 0
                    set {_t} to "%{_plante}%"
                    agritech_set_stat({_id},{_t})

function agritech_prod_type(id: number,loc: location):


    set {_plante} to type of block at {_loc}

    if {agritech_data-type::*} contain {_plante}:

        set {_return} to agritech_verif_energie({_id},false)
        if {_return} is true:

            set {_text} to "%{_plante}%"
            set {_return} to agritech_verif_stockage({_id},{agritech_data-nb-%{_text}%})
            if {_return} is true:

                agritech_verif_energie({_id},true)
                set block at {_loc} to air
                set {_t} to "%{_plante}%"
                agritech_set_stat({_id},{_t})


function agritech_prod_hauteur(id: number,loc: location):

    set {_plante} to type of block at {_loc}
    if "%{_plante}%" contain "cactus":
        set {_plante} to cactus
    set {_text} to "%{_plante}%"

    if {agritech_data-hauteur::*} contain {_plante}:

        set {_return} to agritech_verif_energie({_id},false)
        if {_return} is true:
        
            set {_var} to {_loc}
            set {_nb} to 0
            loop 26 times:
                add 1 to y-coordinate of {_var}
                if "%type of block at {_var}%" does not contain "%{_plante}%":
                    remove 1 from y-coordinate of {_var}
                    exit loop
                else:
                    add 1 to {_nb}
        
        if {_nb} > 0:
            loop {_nb} times:
                if "%type of block at {_var}%" contain "%{_plante}%":
                    if {_var} is not {_loc}:
                        set {_return} to agritech_verif_energie({_id},false)
                        if {_return} is true:

                            set {_return} to agritech_verif_stockage({_id},{agritech_data-nb-%{_text}%})
                            if {_return} is true:
                                set block at {_var} to air
                                agritech_verif_energie({_id},true)
                                set {_t} to "%{_plante}%"
                                agritech_set_stat({_id},{_t})
                                remove 1 from y-coordinate of {_var}
                            else:
                                exit loop
                        else:   
                            exit loop
                    else:
                        exit loop
                else:
                    exit loop

                        

        
                
