
function agritech_prod_age(id: number,loc: location):

    set {_plante} to block at {_loc}
    if {agritech_data-age::*} contain {_plante}:

        set {_return} to agritech_verif_energie({_id},false)
        if {_return} is true:

            if age of {_plante} is maximum age of {_plante}:
                agritech_verif_energie({_id},true)
                if {_plante} is sweet berry bush:
                    set age of {_plante} to 1
                else:
                    set age of {_plante} to 0
                agritech_set_stat({_id},{_plante})

function agritech_prod_type(id: number,loc: location):

    set {_plante} to block at {_loc}
    if {agritech_data-type::*} contain {_plante}:

        set {_return} to agritech_verif_energie({_id},false)
        if {_return} is true:

            agritech_verif_energie({_id},true)
            set block at {_loc} to air
            agritech_set_stat({_id},{_plante})


function agritech_prod_hauteur(id: number,loc: location):
    
    set {_plante} to block at {_loc}
    if {agritech_data-hauteur::*} contain {_plante}:

        set {_return} to agritech_verif_energie({_id},false)
        if {_return} is true:

            set {_var} to {_loc}
            set {_nb} to 0
            loop 26 times:
                add 1 to y-coordinate of {_var}
                if block at {_var} is not {_plante}:
                    remove 1 from y-coordinate of {_var}
                    exit loop
                else:
                    add 1 to {_nb}
        
        if {_nb} > 0:
            loop {_nb} times:
                if block at {_var} is {_plante}:
                    if {_var} is not {_loc}:
                        set {_return} to agritech_verif_energie({_id},false)
                        if {_return} is true:
                            set block at {_var} to air
                            agritech_verif_energie({_id},true)
                            agritech_set_stat({_id},{_plante})
                            remove 1 from y-coordinate of {_var}
                        else:   
                            exit loop
                    else:
                        exit loop
                else:
                    exit loop

                        

        
                


