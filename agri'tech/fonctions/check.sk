
function agritech_verif_nombre(p: player) ::boolean:
    set {_max} to {Grade_%{_p}%}*2
    if size of {agritech_list-%{_p}%::*} >= {_max}:
        return false
    else:
        return true

function agritech_verif_proxy(loc: location) ::boolean:
	loop blocks in radius 8 around {_loc}:
		if {agritech_reverse::%location of loop-block%} is set:
			return false
	return true

function agritech_verif_stockage(id: number,nb: number) ::boolean:

    set {_stock} to 0
    loop {agritech_%{_id}%::stockage::*}:
        add loop-value to {_stock}

    set {_max} to 256*{agritech_%{_id}%::niveau}

    if ({_max}-{_stock}) >= {_nb}:
        return true

    else:
        return false

function agritech_pourcentage_stockage_restant(id: number) ::number:

    set {_stock} to 0
    loop {agritech_%{_id}%::stockage::*}:
        add loop-value to {_stock}

    set {_max} to 256*{agritech_%{_id}%::niveau}
    if {_max} <= 0:
        return 0

    set {_restant} to {_max} - {_stock}
    if {_restant} < 0:
        set {_restant} to 0
    if {_restant} > {_max}:
        set {_restant} to {_max}

    return ({_restant} / {_max}) * 100

function agritech_check_time(id: number) ::boolean:

    set {_minutes} to 12-{agritech_%{_id}%::niveau}
    set {_minutes} to "%{_minutes}% minutes" parsed as timespan

    set {_difference} to difference between {agritech_%{_id}%::last} and now
    if {_difference} > {_minutes}:
        return true
        set {agritech_%{_id}%::last} to now
    else:
        return false
