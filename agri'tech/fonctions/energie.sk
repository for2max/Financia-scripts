
function agritech_verif_energie(id: number,use: boolean) ::boolean:

    if {agritech_%{_id}%::redstone} <= 0:
        if {agritech_%{_id}%::utilisation} <= 0:
            return false
        else:
            if {_use} is true:
                remove 1 from {agritech_%{_id}%::utilisation}
            return true
    else:
        if {agritech_%{_id}%::utilisation} <= 0:
            if {_use} is true:
                remove 1 from {agritech_%{_id}%::redstone}
                set {agritech_%{_id}%::utilisation} to 7+{agritech_%{_id}%::niveau}
                remove 1 from {agritech_%{_id}%::utilisation}
            return true
        else:
            if {_use} is true:
                remove 1 from {agritech_%{_id}%::utilisation}
            return true


function agritech_recharge_energie(id: number,envoi: number) :: number:

    if {_envoi} <= 0:
        return 0

    set {_max} to 64 * {agritech_%{_id}%::niveau}
    set {_energie} to {agritech_%{_id}%::redstone}
    if {_energie} is not set:
        set {_energie} to 0
    if {_energie} >= {_max}:
        return 0

    set {_place-restante} to {_max} - {_energie}
    if {_envoi} < {_place-restante}:
        set {_final} to {_envoi}
    else:
        set {_final} to {_place-restante}

    set {_owner} to {agritech_%{_id}%::owner}
    remove {_final} of redstone from {_owner}'s inventory
    add {_final} to {agritech_%{_id}%::redstone}
    return {_final}
