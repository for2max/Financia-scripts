function Casino_A(loc: location):

    add 0.75 to y-coordinate of {_loc}
    spawn item display at {_loc}
    set item of last spawned item display to red carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from -0.50, -0, 0
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
    add -0.50 to x-coordinate of {_loc2}
    add {_loc2} to {Casino.2::*}

    spawn item display at {_loc}
    set item of last spawned item display to black carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from 0.0, -0, 0.0
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
    add {_loc2} to {Casino.2::*}

    spawn item display at {_loc}
    set item of last spawned item display to red carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from 0.0, -0, -0.50
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
    add -0.50 to z-coordinate of {_loc2}
    add {_loc2} to {Casino.2::*}


function Casino_C(loc: location):

    add 0.75 to y-coordinate of {_loc}

    spawn item display at {_loc}
    set item of last spawned item display to black carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from 0.0, -0, -0.0
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
    add {_loc2} to {Casino.2::*}

    spawn item display at {_loc}
    set item of last spawned item display to red carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from -0.50, -0, 0
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
    add -0.50 to x-coordinate of {_loc2}
    add {_loc2} to {Casino.2::*}

    spawn item display at {_loc}
    set item of last spawned item display to black carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from -1, -0, -0.0
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
    add -1 to x-coordinate of {_loc2}
    add {_loc2} to {Casino.2::*}


function Casino_F(loc: location):

    add 0.75 to y-coordinate of {_loc}

    spawn item display at {_loc}
    set item of last spawned item display to red carpet
    set the scale of last spawned item display to vector(0.50,0.50,0.50)
    set transformation translation of last spawned item display to vector from -0.0, -0, -0.50
    add last spawned item display to {CASINO::*}

    set {_loc2} to {_loc}
