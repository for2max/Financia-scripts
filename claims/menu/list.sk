function Claim_List(p: player,page: number,provenance: text):

    set {_size} to size of {Claim_list.%{_p}%::*}
    set {_nbpage} to floor({_size} / 36) + 1
    
    set {_texture} to "eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvYWM5YzY3YTlmMTY4NWNkMWRhNDNlODQxZmU3ZWJiMTdmNmFmNmVhMTJhN2UxZjI3MjJmNWU3ZjA4OThkYjlmMyJ9fX0="
    set {_droite} to player head with skull value {_texture}
    
    set {_texture} to "eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvMWExZWYzOThhMTdmMWFmNzQ3NzAxNDUxN2Y3ZjE0MWQ4ODZkZjQxYTMyYzczOGNjOGE4M2ZiNTAyOTdiZDkyMSJ9fX0="
    set {_gauche} to player head with skull value {_texture}



    create a new gui with virtual chest inventory named "Vos claims - Page %{_page}%/%{_nbpage}%" with 6 rows:
        open last created gui to {_p}
        Menu({_p})
        loop 9 times:
            make gui slot ((loop-number)-1) with gray stained glass pane
        set {_s} to 9
        loop 36 times:
            make gui slot (9+(loop-number)-1) with light blue stained glass pane
        set {_s} to 45
        loop 9 times:
            make gui slot ((45+loop-number)-1) with gray stained glass pane

        make gui slot 49 with oak door named "&cRetour":
            Claim_Map_Gui({_p},{_provenance})
        make gui slot 47 with {_gauche} named "&ePage précédente":
            if {_page} is 1:
                NO({_p})
            else:
                set {_prev} to {_page}-1
                Claim_List({_p},({_prev}),{_provenance})
        make gui slot 51 with {_droite} named "&ePage suivante":
            if {_nbpage} is {_page}:
                NO({_p})
            else:
                set {_next} to {_page}+1
                Claim_List({_p},({_next}),{_provenance})

        set {_start} to ((36*{_page})+1-36)
        set {_end} to {_start} + 36
        set {_s} to 9
        set {_loop} to 0
        loop {Claim_list.%{_p}%::*}:
            add 1 to {_loop}
            if {_loop} is {_end}:
                exit loop
            if {_loop} >= {_start}:
                if {Claim_%loop-value%::name} is not set:
                    set {_name} to "%loop-value%"
                    replace all "of conquete" with "" in {_name}
                else:
                    set {_name} to {Claim_%loop-value%::name}
                set {_x} to x-coordinate of {Claim_%loop-value%::loc}
                set {_z} to z-coordinate of {Claim_%loop-value%::loc}
                set {_chunk} to loop-value
                make gui slot {_s} with map named "&e%{_name}%" with lore "&7x: &e%{_x}% &7z: &e%{_z}%", "", "&9Cliquez ici pour configurer.":
                    Claim_config({_p},{_chunk},{_page},{_provenance})
                add 1 to {_s}

        